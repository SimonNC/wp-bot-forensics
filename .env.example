# Elastic stack (docker compose reads this file as .env)
STACK_VERSION=8.19.23
# Passwords: letters and digits only (interpolated into JSON/shell in docker-compose.yml).
ELASTIC_PASSWORD=change-me
KIBANA_PASSWORD=change-me-too
KIBANA_ENCRYPTION_KEY=replace-with-32-or-more-random-characters
ES_URL=http://localhost:9200
KIBANA_URL=http://localhost:5601

# Pseudonymisation: keep secret, never commit.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
PSEUDO_KEY=dev-only-key
SITE_DOMAIN=site.example
SITE_LABEL=site.example
CUSTOM_LOGIN_SLUG=

# GeoIP: DB-IP Lite (CC BY 4.0), downloaded by scripts/download_geo.py
ASN_DB=data/geo/dbip-asn-lite.mmdb
COUNTRY_DB=data/geo/dbip-country-lite.mmdb

# Log download (scripts/fetch_logs.sh)
VPS_HOST=user@your-server
SSH_KEY=~/.ssh/id_ed25519
REMOTE_LOG_DIR=log-archive/site
